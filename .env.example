# FeedbackX runtime configuration
# Copy to .env for local development. All values are optional — the service runs fully
# functional deterministic analysis with no configuration at all.

# --- Optional free-tier LLM enrichment (Ollama) ---
# Ollama (https://ollama.com) runs open models locally at zero cost. When enabled and
# reachable, FeedbackX asks it to write the executive summary; otherwise it falls back
# to a deterministic summary built from the computed metrics. The hosted live demo runs
# with this OFF, since a public server has no local Ollama to reach.
FEEDBACKX_ENABLE_LLM=false
FEEDBACKX_OLLAMA_HOST=http://localhost:11434
FEEDBACKX_OLLAMA_MODEL=llama3.2

# Free-form deployment label surfaced for operators/logs.
ENVIRONMENT=development
